{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisprtype",
  "version": "0.1.0",
  "identifier": "com.wisprtype.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wisprtype V1 - Settings",
        "width": 800,
        "height": 600,
        "visible": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Wisprtype Status",
        "width": 300,
        "height": 80,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
